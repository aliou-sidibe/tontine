      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"account\" (\"id\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"password_hash\" BLOB NOT NULL, \"password_salt\" BLOB NOT NULL, \"recovery_code_hash\" BLOB NOT NULL, \"recovery_code_salt\" BLOB NOT NULL, \"iterations\" INTEGER NOT NULL, \"failures\" INTEGER NOT NULL DEFAULT 0, \"locked_until\" INTEGER NULL, \"lockouts\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tontine",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tontine\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"places\" INTEGER NOT NULL CHECK(\"places\" >= 1), \"contribution_per_place\" INTEGER NOT NULL CHECK(\"contribution_per_place\" > 0 AND (\"contribution_per_place\" / 10) * 10 = \"contribution_per_place\"), \"tour_days\" INTEGER NOT NULL CHECK(\"tour_days\" >= 1), \"first_day\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "member",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"member\" (\"id\" TEXT NOT NULL, \"tontine_id\" TEXT NOT NULL REFERENCES tontine (id), \"name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
