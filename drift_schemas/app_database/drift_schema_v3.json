        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payment\" (\"id\" TEXT NOT NULL, \"tontine_id\" TEXT NOT NULL REFERENCES tontine (id), \"member_id\" TEXT NOT NULL REFERENCES member (id), \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"method\" TEXT NOT NULL, \"paid_on\" TEXT NOT NULL, \"payout_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
