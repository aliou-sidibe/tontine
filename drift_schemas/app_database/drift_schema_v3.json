        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"slot\" (\"id\" TEXT NOT NULL, \"tontine_id\" TEXT NOT NULL REFERENCES tontine (id), \"tour\" INTEGER NOT NULL CHECK(\"tour\" >= 1), \"member_id\" TEXT NOT NULL REFERENCES member (id), \"halves\" INTEGER NOT NULL CHECK(\"halves\" IN (1, 2)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payment",
